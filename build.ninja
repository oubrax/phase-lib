builddir = build

cxx = clang++
cxxflags = -std=c++20 -O0 -g -Wall -Wextra
incflags = -Iinclude

rule cxx
  command = $cxx $cxxflags $incflags -MMD -MF $out.d -c $in -o $out
  description = CXX $out
  depfile = $out.d
  deps = gcc

rule link
  command = $cxx $cxxflags -o $out $in
  description = LINK $out

build $builddir/main.o: cxx src/main.cpp
build $builddir/widget.o: cxx src/widget.cpp
build $builddir/container.o: cxx src/container.cpp

build $builddir/phase: link $builddir/main.o $builddir/widget.o $builddir/container.o

default $builddir/phase
